# Installs RetroArch from Flathub (remote defined in
# /usr/share/flatpak/remotes.d/flathub.flatpakrepo) once it's missing. Without
# internet (e.g. hotspot only), it fails and retries every 10 minutes.
[Unit]
Description=Install RetroArch from Flathub
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/app/org.libretro.RetroArch

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak install --system --noninteractive flathub org.libretro.RetroArch
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=multi-user.target
