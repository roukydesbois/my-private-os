// Copied to ~/.config/niri/config.kdl on first login (see
// /usr/share/user-tmpfiles.d/niri-config.conf) and never touched again.
// The real config ships with the image in /usr/share/niri/portocovo.kdl;
// anything below that include overrides it. DMS appends its own includes
// at the end of this file.
include "/usr/share/niri/portocovo.kdl"

// DMS Include Configs
include optional=true "dms/outputs.kdl"
include optional=true "dms/input.kdl"
