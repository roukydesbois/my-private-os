#!/bin/bash
# Sets the password of the Ergo IRC operator "admin": hashes it with the Ergo
# image's genpasswd, writes the hash to /etc/ergo/ergo.env (outside the repo)
# and restarts ergo.service.

set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
	exec sudo "$0" "$@"
fi

read -rsp "IRC operator password: " password
echo
read -rsp "Again: " again
echo
if [ "$password" != "$again" ]; then
	echo "The passwords don't match" >&2
	exit 1
fi

# Without a terminal, genpasswd reads one line and prints the hash last
hash=$(printf '%s\n' "$password" |
	podman run --rm -i --entrypoint /ircd-bin/ergo ghcr.io/ergochat/ergo:stable genpasswd |
	tail -n 1)
case "$hash" in
'$2'*) ;;
*)
	echo "Unexpected output from genpasswd: $hash" >&2
	exit 1
	;;
esac

umask 077
printf 'ERGO__OPERS__ADMIN__PASSWORD=%s\n' "$hash" >/etc/ergo/ergo.env
systemctl restart ergo.service
echo "Operator password set, ergo.service restarted. Log in with /OPER admin <password>."
